# Required for the Foundry. Get one at console.anthropic.com.
ANTHROPIC_API_KEY=

# Database. Leave both empty to use the local file data/fidelis.db.
# Deployed (Vercel): your Turso database URL and token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Foundry rate limit per client address. 0 turns it off
# (useful on a gallery network where every visitor shares one address).
# FOUNDRY_RATE_LIMIT=6
# FOUNDRY_RATE_WINDOW_MINUTES=10
