---
// One project on the unit grid: cover, portrait, thumbnails, info column, and a glyph.
import Media from './Media.astro';
import Glyph from './Glyph.astro';
import { pad, thumbs, spec } from '../lib/work.js';
const { p, n, L, glyph, id } = Astro.props;
const href = `/work/${p.slug}`;
---
<section class="g24 mod" id={id}>
  <a class="cell m-cover" href={href} style={`--a:${L.cover}`}>
    <span class="cap">{p.title}, {p.year}</span>
    <Media media={p.cover} ratio="l" />
  </a>
  <a class="cell m-port" href={href} style={`--a:${L.port}`} tabindex="-1" aria-hidden="true"><Media media={p.portrait} ratio="p" /></a>
  {thumbs(p).map((m, k) => <div class="cell m-thumb" style={`--a:${L.thumbs[k]}`} aria-hidden="true"><Media media={m} ratio="l" /></div>)}
  <div class="cell m-info" style={`--a:${L.info}`}>
    <a class="bar" href={href}><span><span class="no">{pad(n)}</span>{p.title}</span><span>{p.year}</span></a>
    <p class="m-line">{p.line}</p>
    <dl class="kv">{spec(p).map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}
      {p.live && <><dt>Live</dt><dd><a href={p.live} target="_blank" rel="noopener">Visit site</a></dd></>}
    </dl>
    <p class="m-intro">{p.intro}</p>
    <a class="bar go" href={href}><span>View project</span><span>+</span></a>
  </div>
  <div class="cell glyph-cell m-glyph" style={`--a:${L.glyph}`}><Glyph kind={glyph} /></div>
</section>
