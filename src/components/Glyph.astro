---
// Line-art glyphs, drawn as hairline strokes. `mark` is the favicon mark in outline.
const { kind = 'eye', class: cls = '' } = Astro.props;
---
<svg class={`glyph ${cls}`} viewBox={kind === 'mark' ? '0 0 1000 1000' : '0 0 100 100'} aria-hidden="true">
  {kind === 'mark' && (
    <>
      <path d="M644.22,133.53c17.99,17.99,21.43,36.78,11.91,60.86-8.73,21.96-30.7,39.43-56.63,36.78l-78.33-7.94c-12.44-1.32-23.29-1.06-35.72,0l-77.8,7.67c-24.08,2.38-44.46-14.02-53.45-33.34-10.32-22.23-6.62-47.37,10.58-64.57l49.48-50.01c51.6-44.19,122.25-44.19,178.88,0" />
      <path d="M123.98,760.15c16.41,0,32.02,4.23,45.51,11.64l83.62,43.4c31.75,16.67,31.75,62.19,0,78.86l-83.62,43.4c-13.5,7.41-29.11,11.64-45.51,11.64-52.39,0-94.73-42.34-94.73-94.73s42.34-94.73,94.73-94.73v.53Z" />
      <path d="M876.02,949.62c-16.41,0-32.02-4.23-45.51-11.64l-83.62-43.4c-31.75-16.67-31.75-62.19,0-78.86l83.62-43.4c13.5-7.41,29.11-11.64,45.51-11.64,52.39,0,94.73,42.34,94.73,94.73s-42.34,94.73-94.73,94.73v-.53Z" />
      <ellipse cx="821.65" cy="478.96" rx="77.8" ry="104" transform="translate(-129.4 474.99) rotate(-30)" />
      <ellipse cx="178.58" cy="478.58" rx="104" ry="77.8" transform="translate(-325.17 393.94) rotate(-60)" />
    </>
  )}
  {kind === 'eye' && (
    <>
      <circle cx="50" cy="50" r="48" />
      <path d="M8 50 C 28 26, 72 26, 92 50 C 72 74, 28 74, 8 50 Z" />
      <circle cx="50" cy="50" r="12" />
    </>
  )}
  {kind === 'loop' && (
    <>
      <path d="M50 6 A 44 44 0 1 1 11 30" />
      <path d="M4 24 L 11 30 L 18 22" />
      <path d="M50 28 A 22 22 0 1 0 72 50" />
    </>
  )}
  {kind === 'plus' && (
    <>
      <circle cx="50" cy="50" r="48" />
      <path d="M50 18 V 82 M18 50 H 82" />
    </>
  )}
</svg>
