---
import Media from './Media.astro';
const { href, n, title, meta, line, media, ratio = 'l', order } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag class={`tile${href ? ' link' : ''}`} href={href} style={order != null ? `order:${order}` : undefined}>
  <span class="tbar">
    <span class="pill tt">{n && <span class="tn">{n}</span>}{title}</span>
    {meta && <span class="pill tm">{meta}</span>}
  </span>
  {media && <Media media={media} ratio={ratio} />}
  {line && <span class="tl">{line}</span>}
</Tag>
