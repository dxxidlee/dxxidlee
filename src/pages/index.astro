---
// Homepage: two views of the same work in one system. Expanded is a collage on a square unit grid;
// Grid shows one cover per project, everything at once.
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Module from '../components/Module.astro';
import { site } from '../data/site.js';
import { visible, inProgress, index, showDrafts } from '../data/projects.js';
import { pad, pair, A, layouts, rows } from '../lib/work.js';

const people = [...site.experience, ...site.education];
const shortDate = (d) => (/present/i.test(d) ? 'Now' : (d.match(/\d{4}/g) || ['']).pop());

// Grid view order: projects with the text tiles woven in, like one sheet of everything.
const gridTiles = [];
visible.forEach((p, i) => {
  gridTiles.push({ kind: 'project', p, n: i + 1 });
  if (i === 2) gridTiles.push({ kind: 'experience' });
  if (i === 5 && inProgress[0]) gridTiles.push({ kind: 'wip', w: inProgress[0] });
});
if (visible.length < 3) gridTiles.push({ kind: 'experience' });
inProgress.slice(visible.length < 6 ? 0 : 1).forEach((w) => gridTiles.push({ kind: 'wip', w }));
gridTiles.push({ kind: 'contact' }, { kind: 'index' });

// Expanded view: the experience and in-progress interlude follows the second project.
const sequence = visible.map((p, i) => ({ p, i }));
sequence.splice(Math.min(2, visible.length), 0, { inter: true });

// Mosaic: grid view tiles in mixed sizes that tile a 24 x 12 unit block with no holes.
// Set MOSAIC to false to go back to equal tiles. It only switches on when every tile has a slot.
const mosaic = {
  p1: A(1, 10, 1, 8), p5: A(1, 6, 9, 4), p6: A(7, 4, 9, 4),
  p2: A(11, 5, 1, 6), wip1: A(11, 5, 7, 2), wip0: A(11, 5, 9, 4),
  experience: A(16, 5, 1, 5), p7: A(16, 5, 6, 4), contact: A(16, 5, 10, 3),
  p3: A(21, 4, 1, 4), p4: A(21, 4, 5, 4), index: A(21, 4, 9, 4),
};
const tileKey = (t) => (t.kind === 'project' ? `p${t.n}` : t.kind === 'wip' ? `wip${inProgress.indexOf(t.w)}` : t.kind);
const MOSAIC = true && gridTiles.length === Object.keys(mosaic).length && gridTiles.every((t) => mosaic[tileKey(t)]);
const tileStyle = (t) => (MOSAIC && mosaic[tileKey(t)] ? `--a:${mosaic[tileKey(t)]}` : undefined);
---
<Base>
  <Fragment slot="right">
    <script is:inline>document.currentScript.closest('.vw').dataset.view = localStorage.getItem('dx-view-v2') || 'grid';</script>
    <div class="seg" role="group" aria-label="View">
      <button type="button" data-v="expanded">Expanded</button>
      <button type="button" data-v="grid">Grid</button>
    </div>
    <a class="chip" href="#all"><span>Index</span><span>{pad(rows.length)}</span></a>
  </Fragment>

      <section class="g24 intro">
        <div class="cell i-text" style={`--a:${A(1, 16, 1, 4)}`}>
          <p class="bar"><span>{site.fullName}</span><span>{site.location}</span></p>
          <h1><span class="nm">{site.name}</span> {site.positioning}</h1>
        </div>
        <div class="cell i-side" style={`--a:${A(19, 6, 1, 4)}`}>
          <div class="bars">
            {site.status.map((s) => <p class="bar">{pair(s).map((t) => <span>{t}</span>)}</p>)}
          </div>
          <nav class="i-toc" aria-label="Contents">
            <p class="bar"><span>Contents</span><span>{pad(visible.length)}</span></p>
            <ol>{visible.map((p, i) => <li><a href={`#p-${p.slug}`}><span>{pad(i + 1)}</span>{p.title}<span>+</span></a></li>)}</ol>
          </nav>
        </div>
      </section>

      <div class="vx">
        {sequence.map(({ p, i, inter }) => {
          if (inter) return (
            <section class="g24 inter">
              <div class="x-exp">
                <p class="bar"><span>Experience</span><span>{pad(people.length)}</span></p>
                {people.map((e) => (
                  <details class="acc">
                    <summary><span>{e.org}</span><span class="dim">{e.dates}</span></summary>
                    <p><span class="dim">{e.role}.</span> {e.note}</p>
                  </details>
                ))}
              </div>
              {inProgress.map((w, k) => (
                <div class={`x-wip x-wip${k}`}>
                  {w.image && (w.image.src || showDrafts) ? <Media media={w.image} ratio="p" /> : <div class="x-blank"><p>{w.line}</p></div>}
                  <p class="bar"><span>{w.title}</span><span class="dim">{w.meta}</span></p>
                </div>
              ))}
            </section>
          );
          return <Module p={p} n={i + 1} L={layouts[i % layouts.length]} id={`p-${p.slug}`} />;
        })}
      </div>

      <div class="vg">
        <div class={MOSAIC ? "gt-grid mosaic" : "gt-grid"}>
          {gridTiles.map((t) => {
            if (t.kind === 'project') return (
              <a class="gt" href={`/work/${t.p.slug}`} style={tileStyle(t)}>
                <span class="bar"><span><span class="no">{pad(t.n)}</span>{t.p.title}</span><span>{t.p.year}</span></span>
                <Media media={t.p.cover} ratio="l" />
                <span class="gt-line">{t.p.line}</span>
              </a>
            );
            if (t.kind === 'wip') return (
              <div class="gt" style={tileStyle(t)}>
                <span class="bar"><span>{t.w.title}</span><span class="dim">{t.w.meta}</span></span>
                {t.w.image && (t.w.image.src || showDrafts) ? <Media media={t.w.image} ratio="l" /> : <span class="gt-body gt-soft"><span>In progress</span></span>}
                <span class="gt-line">{t.w.line}</span>
              </div>
            );
            if (t.kind === 'experience') return (
              <div class="gt" style={tileStyle(t)}>
                <span class="bar"><span>Experience</span><span>{pad(people.length)}</span></span>
                <ul class="gt-body gt-list">{people.map((e) => <li><span>{e.org}</span><span class="dim">{shortDate(e.dates)}</span></li>)}</ul>
                <span class="gt-line"><a href="/info">More on the info page +</a></span>
              </div>
            );
            if (t.kind === 'contact') return (
              <div class="gt" style={tileStyle(t)}>
                <span class="bar"><span>Contact</span><span>{site.location}</span></span>
                <ul class="gt-body gt-list">
                  <li><a href={`mailto:${site.email}`}>{site.email}</a><span>+</span></li>
                  <li><a href={site.resume} target="_blank">Resume</a><span>+</span></li>
                  {site.links.map((l) => <li><a href={l.href} target="_blank" rel="noopener">{l.label}</a><span>+</span></li>)}
                </ul>
                <span class="gt-line"></span>
              </div>
            );
            return (
              <div class="gt" style={tileStyle(t)}>
                <span class="bar"><span>Other work</span><span>{pad(index.length)}</span></span>
                <ul class="gt-body gt-list">{index.slice(0, 7).map((r) => <li><span>{r.href ? <a href={r.href} target="_blank" rel="noopener">{r.title}</a> : r.title}</span><span class="dim">{r.year}</span></li>)}</ul>
                <span class="gt-line"><a href="#all">Everything, newest first +</a></span>
              </div>
            );
          })}
        </div>
      </div>

      <section class="all" id="all">
        <div class="tools">
          <p class="bar"><span>All work</span><span>{pad(rows.length)}</span></p>
          <p class="bar"><span>Newest first</span><span>↓</span></p>
        </div>
        <table>
          <thead><tr><th>No.</th><th>Title</th><th>Type</th><th>Year</th><th>Role</th><th>Link</th></tr></thead>
          <tbody>
            {rows.map((r, k) => (
              <tr>
                <td>{pad(k + 1)}</td>
                <td>{r.title}</td>
                <td>{r.type}</td>
                <td>{r.year}</td>
                <td>{r.role}</td>
                <td>{r.href ? <a href={r.href} target={r.href.startsWith('http') ? '_blank' : undefined} rel="noopener">{r.label} +</a> : ''}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
</Base>

<script>
  const root = document.querySelector('.vw');
  const buttons = root.querySelectorAll('[data-v]');
  const sync = () => buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.v === root.dataset.view)));
  buttons.forEach((b) => b.addEventListener('click', () => {
    root.dataset.view = b.dataset.v;
    localStorage.setItem('dx-view-v2', b.dataset.v);
    sync();
    window.scrollTo({ top: 0 });
  }));
  sync();
</script>

<style is:global>
  .inter{grid-auto-rows:auto;align-items:start;margin-bottom:calc(var(--u) * 2);}
  .x-exp{grid-column:1 / span 8;}
  .x-wip{display:flex;flex-direction:column;gap:var(--gap);}
  .x-wip0{grid-column:11 / span 5;}
  .x-wip1{grid-column:16 / span 5;}
  .x-blank{aspect-ratio:4/5;background:var(--pill);display:flex;align-items:flex-end;}
  .x-blank p{padding:7px;font-size:18px;line-height:1.12;letter-spacing:-.015em;font-weight:300;}
  /* grid view */
  .vg{display:none;padding-bottom:calc(var(--gap) * 12);}
  .gt-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px var(--gap);}
  .gt{display:flex;flex-direction:column;gap:var(--gap);min-width:0;}
  a.gt:hover{text-decoration:none;}
  a.gt:hover .bar{background:var(--ph);}
  .gt-body{aspect-ratio:16/10;margin:0;overflow:hidden;}
  .gt-soft{background:var(--pill);display:flex;align-items:flex-end;padding:7px;color:var(--mute);}
  .gt-list{list-style:none;padding:0;}
  .gt-list li{display:flex;justify-content:space-between;gap:12px;padding:2px 7px;border-bottom:1px solid var(--rule);white-space:nowrap;}
  .gt-list li > :first-child{overflow:hidden;text-overflow:ellipsis;}
  .gt-list li > :last-child{flex-shrink:0;}
  .gt-line{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:2.6em;padding:0 7px;}

  .vw[data-view="grid"] .vx{display:none;}
  .vw[data-view="grid"] .vg{display:block;}
  .vw[data-view="grid"] .i-toc{visibility:hidden;}
  .gt-grid{grid-template-columns:repeat(6,minmax(0,1fr));}

  @container (min-width:1260px){
    .gt-grid.mosaic{--u:calc((100cqw - 23 * var(--gap)) / 24);grid-template-columns:repeat(24,var(--u));grid-auto-rows:var(--u);gap:var(--gap);}
    .mosaic .gt{grid-area:var(--a);min-height:0;overflow:hidden;}
    .mosaic .gt > .slot,.mosaic .gt > .gt-body{flex:1 1 0;min-height:0;aspect-ratio:auto;}
  }

  /* everything table */
  .all{scroll-margin-top:48px;}
  .tools{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--gap);margin-bottom:16px;}
  .all table{width:calc(100% + 2 * var(--gap));border-collapse:separate;border-spacing:var(--gap) 0;margin:0 calc(-1 * var(--gap));table-layout:fixed;}
  .all th{text-align:left;font-weight:400;color:var(--mute);padding:4px 0;}
  .all td{padding:5px 0 3px;border-bottom:1px solid var(--rule);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .all th:nth-child(1){width:6%;} .all th:nth-child(2){width:22%;} .all th:nth-child(3){width:30%;}
  .all th:nth-child(4){width:11%;} .all th:nth-child(5){width:20%;}
  .all td:nth-child(1),.all td:nth-child(3),.all td:nth-child(4),.all td:nth-child(5){color:var(--mute);}

  @container (max-width:1270px){ .gt-grid{grid-template-columns:repeat(4,minmax(0,1fr));} }
  @container (max-width:980px){ .gt-grid{grid-template-columns:repeat(3,minmax(0,1fr));} }

  @media (max-width:760px){

    .inter{gap:24px;margin-bottom:32px;}
    .gt-grid{grid-template-columns:1fr;gap:28px;}
    .gt-body.gt-list{aspect-ratio:auto;}
    .gt-soft{aspect-ratio:auto;min-height:80px;}

    .tools{grid-template-columns:1fr 1fr;}
    .all table,.all tbody{display:block;width:100%;margin:0;}
    .all thead{display:none;}
    .all tr{display:grid;grid-template-columns:1fr auto;column-gap:12px;padding:6px 0 5px;border-bottom:1px solid var(--rule);}
    .all td{border:0;padding:0;white-space:normal;}
    .all td:nth-child(1),.all td:nth-child(5){display:none;}
    .all td:nth-child(2){grid-column:1;}
    .all td:nth-child(4){grid-column:2;grid-row:1;}
    .all td:nth-child(3){grid-column:1;color:var(--mute);}
    .all td:nth-child(6){grid-column:2;grid-row:2;text-align:right;}
  }
</style>
