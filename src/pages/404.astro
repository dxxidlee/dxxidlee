---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.js';
import { A } from '../lib/work.js';
---
<Base title={`Not found, ${site.name}`}>
  <section class="g24 intro">
    <div class="cell i-text" style={`--a:${A(1, 16, 1, 4)}`}>
      <p class="bar"><span>404</span><span>Not found</span></p>
      <h1><span class="nm">Not found.</span> This page doesn't exist, or it moved.</h1>
    </div>
    <div class="cell i-side" style={`--a:${A(19, 6, 1, 4)}`}>
      <a class="bar go" href="/"><span>Back to selected work</span><span>+</span></a>
    </div>
  </section>
</Base>
