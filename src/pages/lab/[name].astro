---
// Layout experiment in the Hard Sun register. Same data as the homepage, draft builds only.
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import Glyph from '../../components/Glyph.astro';
import { site } from '../../data/site.js';
import { visible, inProgress, index, showDrafts } from '../../data/projects.js';

export function getStaticPaths() {
  return showDrafts ? [{ params: { name: 'hard-sun' } }] : [];
}

const pad = (n) => String(n).padStart(3, '0');
const thumbs = (p) => p.blocks
  .flatMap((b) => (b.type === 'pair' ? [b.a, b.b] : b.media ? [b.media] : []))
  .slice(0, 3);
const spec = (p) => [['Year', p.year], ['Role', p.role], ['Deliverables', p.tags], ['Tools', p.tools]];

const lastYear = (y) => Math.max(0, ...(String(y).match(/\d{4}/g) || []).map(Number));
const rows = [
  ...visible.map((p) => ({ title: p.title, type: p.tags, year: p.year, role: p.role, href: `/work/${p.slug}`, label: 'Case study' })),
  ...index.map((r) => ({ title: r.title, type: r.type, year: r.year, role: '', href: r.href, label: r.href ? 'Visit' : '' })),
].sort((a, b) => lastYear(b.year) - lastYear(a.year));

const glyphs = ['mark', 'eye', 'loop', 'plus'];
---
<Base title={`Lab, ${site.name}`} bare>
  <div class="hs">
    <header class="hs-top">
      <a class="hs-logo" href="/">{site.name}</a>
      <a class="chip" href="#all"><span>Index</span><span>{pad(rows.length)}</span></a>
    </header>

    <section class="mod intro">
      <div class="i-text">
        <p class="bar"><span>{site.name}</span><span>{site.location}</span></p>
        <h1>{site.positioning}</h1>
        <ul class="kv-list">{site.status.map((s) => <li>{s}</li>)}</ul>
      </div>
      <Glyph kind="mark" class="i-glyph" />
      <nav class="i-toc" aria-label="Contents">
        <p class="bar"><span>Contents</span><span>{pad(visible.length)}</span></p>
        <ol>{visible.map((p, i) => <li><a href={`#p-${p.slug}`}><span>{pad(i + 1)}</span>{p.title}<span class="plus">+</span></a></li>)}</ol>
      </nav>
    </section>

    {visible.map((p, i) => (
      <>
        <section class={`mod v${i % 4}`} id={`p-${p.slug}`}>
          <div class="m-thumbs">{thumbs(p).map((m) => <Media media={m} ratio="l" />)}</div>
          <a class="m-cover" href={`/work/${p.slug}`}>
            <span class="cap">{p.title}, {p.year}</span>
            <Media media={p.cover} ratio="l" />
          </a>
          <a class="m-port" href={`/work/${p.slug}`} tabindex="-1" aria-hidden="true"><Media media={p.portrait} ratio="p" /></a>
          <div class="m-info">
            <p class="bar"><span><span class="no">{pad(i + 1)}</span>{p.title}</span><span>{p.year}</span></p>
            <p class="m-line">{p.line}</p>
            <dl class="kv">{spec(p).map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}
              {p.live && <><dt>Live</dt><dd><a href={p.live} target="_blank" rel="noopener">Visit site</a></dd></>}
            </dl>
            <p class="m-intro">{p.intro}</p>
            <a class="bar go" href={`/work/${p.slug}`}><span>View project</span><span>+</span></a>
          </div>
          <Glyph kind={glyphs[(i + 1) % glyphs.length]} />
        </section>

        {i === 1 && (
          <section class="mod inter">
            <div class="x-exp">
              <p class="bar"><span>Experience</span><span>{pad(site.experience.length)}</span></p>
              {site.experience.map((e) => (
                <details class="acc">
                  <summary><span>{e.org}</span><span class="dim">{e.dates}</span></summary>
                  <p><span class="dim">{e.role}.</span> {e.note}</p>
                </details>
              ))}
              {site.education.map((e) => (
                <details class="acc">
                  <summary><span>{e.org}</span><span class="dim">{e.dates}</span></summary>
                  <p><span class="dim">{e.role}.</span> {e.note}</p>
                </details>
              ))}
            </div>
            {inProgress.map((w, k) => (
              <div class={`x-wip x-wip${k}`}>
                {w.image && (w.image.src || showDrafts) && <Media media={w.image} ratio="p" />}
                <details class="acc tab">
                  <summary><span>{w.title}, {w.meta}</span></summary>
                  <p>{w.line}</p>
                </details>
              </div>
            ))}
            <Glyph kind="plus" />
          </section>
        )}
      </>
    ))}

    <section class="all" id="all">
      <div class="tools">
        <p class="bar"><span>All work</span><span>{pad(rows.length)}</span></p>
        <p class="bar"><span>Newest first</span><span>↓</span></p>
        <p class="bar"><span>{site.status[0]}</span><span></span></p>
      </div>
      <div class="scroller">
        <table>
          <thead><tr><th>No.</th><th>Title</th><th>Type</th><th>Year</th><th>Role</th><th>Link</th></tr></thead>
          <tbody>
            {rows.map((r, k) => (
              <tr>
                <td>{pad(k + 1)}</td>
                <td>{r.title}</td>
                <td>{r.type}</td>
                <td>{r.year}</td>
                <td>{r.role}</td>
                <td>{r.href ? <a href={r.href} target={r.href.startsWith('http') ? '_blank' : undefined} rel="noopener">{r.label} +</a> : ''}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <div class="hs-bottom">
      <a class="chip wide" href={`mailto:${site.email}`}><span>Email</span><span>{site.email}</span></a>
      <p class="bar wide"><span>{site.status[2]}</span><span><a href={site.resume} target="_blank">Resume</a>&nbsp;&nbsp;<a href="/info">Info</a></span></p>
    </div>
  </div>
</Base>

<style is:global>
  .hs{--gap:5px;padding:0 var(--gap) 120px;font-size:12px;line-height:1.25;color:var(--ink);}
  .hs a:hover{text-decoration:underline;text-underline-offset:2px;}
  .hs .bar{display:flex;justify-content:space-between;gap:12px;background:var(--pill);padding:5px 6px;}
  .hs .chip{display:flex;justify-content:space-between;gap:24px;min-width:84px;background:var(--ink);color:var(--bg);padding:5px 7px;}
  .hs .dim{color:var(--mute);}
  .hs .no{display:inline-block;min-width:34px;}
  .hs .glyph{display:block;width:100%;height:auto;fill:none;stroke:var(--ink);stroke-width:1.25;}
  .hs .glyph *{vector-effect:non-scaling-stroke;}

  .hs-top{position:fixed;z-index:40;inset:0 0 auto 0;display:flex;justify-content:space-between;align-items:center;padding:8px var(--gap);pointer-events:none;}
  .hs-top > *{pointer-events:auto;}
  .hs-top > a:first-child{background:var(--white);padding:3px 6px;margin-left:-6px;}
  .hs-logo{font-size:14px;letter-spacing:-.02em;}
  .hs-bottom{position:fixed;z-index:40;left:calc(100% / 24 * 4);right:var(--gap);bottom:var(--gap);display:grid;grid-template-columns:1fr 1fr;gap:var(--gap);}
  .hs-bottom .wide{min-width:0;}

  .mod{display:grid;grid-template-columns:repeat(24,minmax(0,1fr));gap:var(--gap);align-items:start;margin-bottom:var(--gap);scroll-margin-top:40px;}
  .mod .slot{background:var(--ph);}
  .m-thumbs{display:flex;flex-direction:column;gap:var(--gap);}
  .m-cover,.m-port{position:relative;display:block;}
  .m-cover .cap{position:absolute;z-index:1;left:6px;top:5px;color:var(--bg);}
  .m-info{display:flex;flex-direction:column;gap:10px;}
  .m-line{font-size:18px;line-height:1.1;letter-spacing:-.01em;font-weight:300;padding:0 6px;}
  .m-intro{padding:0 6px;display:-webkit-box;-webkit-line-clamp:7;-webkit-box-orient:vertical;overflow:hidden;}
  .kv{display:grid;grid-template-columns:minmax(80px,40%) 1fr;column-gap:12px;row-gap:1px;border-top:1px solid var(--ink);border-bottom:1px solid var(--ink);padding:5px 6px;margin:0;}
  .kv dd{margin:0;}
  .hs .go{margin-top:4px;}

  /* intro */
  .intro{padding-top:64px;margin-bottom:48px;}
  .i-text{grid-column:1 / 10;display:flex;flex-direction:column;gap:14px;}
  .i-text h1{font-size:clamp(28px,3.4vw,52px);line-height:1;letter-spacing:-.03em;font-weight:300;padding:0 6px;}
  .kv-list{border-top:1px solid var(--ink);border-bottom:1px solid var(--ink);padding:5px 6px;}
  .i-glyph{grid-column:11 / 17;margin-top:24px;}
  .i-toc{grid-column:19 / 25;margin-top:40px;}
  .i-toc ol{margin:0;padding:0;list-style:none;}
  .i-toc a{display:grid;grid-template-columns:40px 1fr auto;padding:5px 6px;border-bottom:1px solid var(--rule);}

  /* four module variants, cycled */
  .v0 .glyph{grid-column:4 / 8;grid-row:1;margin-top:24px;}
  .v0 .m-thumbs{grid-column:9 / 12;grid-row:1;}
  .v0 .m-cover{grid-column:12 / 21;grid-row:1 / span 2;}
  .v0 .m-port{grid-column:21 / 25;grid-row:1;margin-top:35%;}
  .v0 .m-info{grid-column:1 / 9;grid-row:2;}

  .v1 .m-cover{grid-column:1 / 12;grid-row:1;}
  .v1 .m-info{grid-column:12 / 17;grid-row:1;align-self:end;}
  .v1 .m-port{grid-column:17 / 25;grid-row:1 / span 2;margin-top:18%;}
  .v1 .m-thumbs{grid-column:4 / 12;grid-row:2;flex-direction:row;}
  .v1 .m-thumbs > *{flex:1;}
  .v1 .glyph{grid-column:13 / 17;grid-row:2;margin-top:24px;}

  .v2 .m-port{grid-column:1 / 6;grid-row:1;}
  .v2 .m-thumbs{grid-column:6 / 8;grid-row:1;}
  .v2 .m-info{grid-column:9 / 14;grid-row:1;margin-top:80px;}
  .v2 .m-cover{grid-column:14 / 25;grid-row:1 / span 2;margin-top:140px;}
  .v2 .glyph{grid-column:2 / 7;grid-row:2;margin-top:24px;}

  .v3 .m-info{grid-column:1 / 6;grid-row:1;margin-top:40px;}
  .v3 .m-cover{grid-column:7 / 25;grid-row:1;margin-right:calc(-1 * var(--gap));}
  .v3 .m-thumbs{grid-column:7 / 15;grid-row:2;flex-direction:row;}
  .v3 .m-thumbs > *{flex:1;}
  .v3 .m-port{grid-column:19 / 23;grid-row:2;}
  .v3 .glyph{grid-column:2 / 6;grid-row:2;margin-top:40px;}

  /* interlude: experience, in progress */
  .inter{margin:48px 0;}
  .x-exp{grid-column:1 / 8;}
  .x-wip{position:relative;background:var(--pill);display:flex;flex-direction:column;justify-content:flex-end;}
  .x-wip0{grid-column:9 / 14;}
  .x-wip1{grid-column:14 / 19;min-height:420px;margin-top:120px;}
  .inter .glyph{grid-column:20 / 25;margin-top:60px;}
  .acc{border-bottom:1px solid var(--rule);}
  .acc summary{display:flex;gap:12px;padding:5px 6px;cursor:pointer;list-style:none;}
  .acc summary::-webkit-details-marker{display:none;}
  .acc summary > :first-child{flex:1;}
  .acc summary::after{content:'+';}
  .acc[open] summary::after{content:'\2212';}
  .acc p{padding:0 6px 8px;max-width:52ch;}
  .acc.tab{border:0;background:var(--bg);align-self:flex-start;min-width:60%;}

  /* everything table */
  .all{margin-top:64px;scroll-margin-top:40px;}
  .tools{display:grid;grid-template-columns:repeat(3,1fr) 2fr;gap:var(--gap);margin-bottom:24px;}
  .scroller{overflow-x:auto;}
  .all table{width:100%;min-width:900px;border-collapse:separate;border-spacing:var(--gap) 0;margin:0 calc(-1 * var(--gap));}
  .all th{text-align:left;font-weight:400;color:var(--mute);padding:4px 0;}
  .all td{padding:5px 0 3px;border-bottom:1px solid var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:0;}
  .all td:nth-child(1){width:5%;} .all td:nth-child(2){width:24%;} .all td:nth-child(3){width:30%;}
  .all td:nth-child(4){width:10%;} .all td:nth-child(5){width:20%;}

  @media (max-width:760px){
    .hs{padding-bottom:90px;}
    .mod{grid-template-columns:repeat(6,minmax(0,1fr));}
    .mod > *{grid-column:1 / -1 !important;grid-row:auto !important;margin:0 !important;}
    .mod .m-cover{order:1;} .mod .m-info{order:2;} .mod .m-thumbs{order:3;flex-direction:row;}
    .mod .m-thumbs > *{flex:1;}
    .mod .m-port{order:4;grid-column:1 / 4 !important;}
    .mod .glyph{order:5;grid-column:4 / 7 !important;align-self:center;}
    .mod{margin-bottom:40px;}
    .intro{padding-top:56px;}
    .i-glyph{width:50% !important;}
    .x-wip1{min-height:240px;}
    .tools{grid-template-columns:1fr 1fr;}
    .tools .bar:last-child{display:none;}
    .hs-bottom{left:var(--gap);grid-template-columns:1fr;}
    .hs-bottom .bar{display:none;}
  }
</style>
