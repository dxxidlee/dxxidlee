---
// Homepage candidate between the live homepage and the Hard Sun lab. Same data, draft builds only.
import Base from '../../../layouts/Base.astro';
import Media from '../../../components/Media.astro';
import { site } from '../../../data/site.js';
import { visible, inProgress, index, showDrafts } from '../../../data/projects.js';

export function getStaticPaths() {
  return showDrafts ? [{ params: { v: undefined } }] : [];
}

const pad = (n) => String(n).padStart(3, '0');
const thumbs = (p) => p.blocks
  .flatMap((b) => (b.type === 'pair' ? [b.a, b.b] : b.media ? [b.media] : []))
  .slice(0, 3);
const spec = (p) => [['Year', p.year], ['Role', p.role], ['Deliverables', p.tags]];

// Categories are read from the existing `tags` / `type` text, so the data files stay as they are.
const CATS = [
  ['print', 'Print', /book|poster|campaign|specimen|zine|album|publication/i],
  ['web', 'Web', /website|web|app|interaction|visualizer/i],
  ['motion', 'Motion', /motion|animation/i],
  ['type', 'Type', /typeface|typography/i],
  ['tools', 'Tools', /tools|scripts/i],
];
const catsOf = (text) => CATS.filter(([, , re]) => re.test(text || '')).map(([k]) => k).join(' ');

const lastYear = (y) => Math.max(0, ...(String(y).match(/\d{4}/g) || []).map(Number));
const rows = [
  ...visible.map((p) => ({ title: p.title, type: p.tags, year: p.year, role: p.role, href: `/work/${p.slug}`, label: 'Case study', cats: catsOf(p.tags) })),
  ...index.map((r) => ({ title: r.title, type: r.type, year: r.year, role: '', href: r.href, label: r.href ? 'Visit' : '', cats: catsOf(r.type) })),
].sort((a, b) => lastYear(b.year) - lastYear(a.year));

const options = [
  { key: 'all', label: 'All', count: rows.length },
  ...CATS.map(([key, label]) => ({ key, label, count: rows.filter((r) => r.cats.split(' ').includes(key)).length })),
].filter((o) => o.count);

const filterCss = CATS.map(([k]) => `.hy[data-f="${k}"] [data-cats]:not([data-cats~="${k}"]){display:none}`).join('')
  + '.hy[data-f]:not([data-f="all"]) .inter{display:none}';
---
<Base title={`Lab, ${site.name}`} bare>
  <div class="hy" data-f="all">
    <header class="hy-top">
      <a class="hy-logo" href="/">{site.name}</a>
      <div class="hy-right">
        <details class="flt">
          <summary class="bar"><span>Filter</span><span><span class="flt-v">All</span>&nbsp;&nbsp;+</span></summary>
          <ul>
            {options.map((o) => (
              <li><button type="button" data-set={o.key} data-label={o.label} aria-pressed={o.key === 'all' ? 'true' : 'false'}>
                <span>{o.label}</span><span class="dim">{pad(o.count)}</span>
              </button></li>
            ))}
          </ul>
        </details>
        <a class="chip" href="#all"><span>Index</span><span>{pad(rows.length)}</span></a>
      </div>
    </header>

    <section class="hy-hero">
      <h1>
        {site.wordmark ? <img class="wordmark" src={site.wordmark} alt={site.name} /> : <span class="nm">{site.name}</span>}
        <span class="ps">{site.positioning}</span>
      </h1>
      <ul class="hy-status">{site.status.map((s) => <li class="bar"><span>{s}</span></li>)}</ul>
    </section>

    <div id="work">
      {visible.map((p, i) => (
        <>
          <section class={`pm ${i % 2 ? 'b' : 'a'}`} id={`p-${p.slug}`} data-cats={catsOf(p.tags)}>
            <a class="p-cover" href={`/work/${p.slug}`}><Media media={p.cover} ratio="l" /></a>
            <a class="p-port" href={`/work/${p.slug}`} tabindex="-1" aria-hidden="true"><Media media={p.portrait} ratio="p" /></a>
            <div class="p-thumbs" aria-hidden="true">{thumbs(p).map((m) => <Media media={m} ratio="l" />)}</div>
            <div class="p-info">
              <a class="bar" href={`/work/${p.slug}`}><span><span class="no">{pad(i + 1)}</span>{p.title}</span><span>{p.year}</span></a>
              <p class="p-line">{p.line}</p>
              <dl class="kv">{spec(p).map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}
                {p.live && <><dt>Live</dt><dd><a href={p.live} target="_blank" rel="noopener">Visit site</a></dd></>}
              </dl>
              <p class="p-intro">{p.intro}</p>
              <a class="bar go" href={`/work/${p.slug}`}><span>View project</span><span>+</span></a>
            </div>
          </section>

          {i === 1 && (
            <section class="inter">
              <div class="x-exp">
                <p class="bar"><span>Experience</span><span>{pad(site.experience.length + site.education.length)}</span></p>
                {[...site.experience, ...site.education].map((e) => (
                  <details class="acc">
                    <summary><span>{e.org}</span><span class="dim">{e.dates}</span></summary>
                    <p><span class="dim">{e.role}.</span> {e.note}</p>
                  </details>
                ))}
              </div>
              <div class="x-wips">
                <p class="bar"><span>In progress</span><span>{pad(inProgress.length)}</span></p>
                <div class="x-row">
                  {inProgress.map((w) => (
                    <div class="x-wip">
                      {w.image && (w.image.src || showDrafts) && <Media media={w.image} ratio="p" />}
                      <p class="x-cap"><span>{w.title}</span><span class="dim">{w.meta}</span></p>
                      <p class="x-line">{w.line}</p>
                    </div>
                  ))}
                </div>
              </div>
            </section>
          )}
        </>
      ))}
    </div>

    <section class="all" id="all">
      <div class="tools">
        <p class="bar"><span>All work</span><span>{pad(rows.length)}</span></p>
        <p class="bar"><span>Newest first</span><span>↓</span></p>
      </div>
      <table>
        <thead><tr><th>No.</th><th>Title</th><th>Type</th><th>Year</th><th>Role</th><th>Link</th></tr></thead>
        <tbody>
          {rows.map((r, k) => (
            <tr data-cats={r.cats}>
              <td>{pad(k + 1)}</td>
              <td>{r.title}</td>
              <td>{r.type}</td>
              <td>{r.year}</td>
              <td>{r.role}</td>
              <td>{r.href ? <a href={r.href} target={r.href.startsWith('http') ? '_blank' : undefined} rel="noopener">{r.label} +</a> : ''}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <div class="hy-bottom">
      <a class="chip" href={`mailto:${site.email}`}><span>Email</span><span>{site.email}</span></a>
      <p class="bar"><span class="avail">{site.status[2]}</span><span><a href={site.resume} target="_blank">Resume</a>&nbsp;&nbsp;<a href="/info">Info</a></span></p>
    </div>
  </div>
</Base>

<style is:inline set:html={filterCss}></style>

<script>
  const root = document.querySelector('.hy');
  const buttons = root.querySelectorAll('[data-set]');
  buttons.forEach((b) => b.addEventListener('click', () => {
    root.dataset.f = b.dataset.set;
    buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    root.querySelector('.flt-v').textContent = b.dataset.label;
    b.closest('details').open = false;
  }));
</script>

<style is:global>
  .hy{--gap:5px;padding:0 var(--gap) 96px;font-size:13px;line-height:1.3;color:var(--ink);}
  .hy a:hover{text-decoration:underline;text-underline-offset:2px;}
  .hy .bar{display:flex;justify-content:space-between;gap:12px;background:var(--pill);padding:5px 7px;}
  .hy a.bar:hover{background:var(--ph);text-decoration:none;}
  .hy .chip{display:flex;justify-content:space-between;gap:24px;background:var(--ink);color:var(--bg);padding:5px 7px;}
  .hy .dim{color:var(--mute);}
  .hy .no{display:inline-block;min-width:38px;}

  .hy-top{position:fixed;z-index:40;inset:0 0 auto 0;display:flex;justify-content:space-between;align-items:flex-start;padding:8px var(--gap);pointer-events:none;}
  .hy-top > *{pointer-events:auto;}
  .hy-logo{background:var(--bg);padding:5px 7px;margin-left:-7px;font-size:14px;letter-spacing:-.02em;}
  .hy-right{display:flex;gap:var(--gap);align-items:flex-start;}
  .hy-right .chip{min-width:96px;}
  .flt{width:220px;}
  .flt summary{cursor:pointer;list-style:none;}
  .flt summary::-webkit-details-marker{display:none;}
  .flt[open] summary{background:var(--ph);}
  .flt ul{margin:0;padding:0;list-style:none;background:var(--bg);border-bottom:1px solid var(--ink);}
  .flt button{all:unset;box-sizing:border-box;display:flex;justify-content:space-between;width:100%;padding:5px 7px;border-bottom:1px solid var(--rule);cursor:pointer;}
  .flt button:hover,.flt button[aria-pressed="true"]{background:var(--pill);}
  .flt button:focus-visible{outline:2px solid var(--ink);outline-offset:-2px;}

  .hy-hero{display:grid;grid-template-columns:repeat(24,minmax(0,1fr));gap:var(--gap);padding:96px 0 72px;align-items:start;}
  .hy-hero h1{grid-column:1 / 17;font-size:clamp(32px,3.7vw,58px);line-height:1.02;letter-spacing:-.035em;font-weight:300;color:var(--mute);}
  .hy-hero .nm{color:var(--ink);font-weight:400;margin-right:.25em;}
  .hy-hero .wordmark{display:inline-block;height:.8em;width:auto;margin-right:.25em;}
  .hy-status{grid-column:19 / 25;display:flex;flex-direction:column;gap:var(--gap);margin:0;padding:0;list-style:none;}

  .pm{display:grid;grid-template-columns:repeat(24,minmax(0,1fr));gap:var(--gap);align-items:start;margin-bottom:72px;scroll-margin-top:48px;}
  .pm a{display:block;}
  .p-info{display:flex;flex-direction:column;gap:10px;}
  .p-line{font-size:19px;line-height:1.12;letter-spacing:-.015em;font-weight:300;padding:0 7px;}
  .p-intro{padding:0 7px;display:-webkit-box;-webkit-line-clamp:5;-webkit-box-orient:vertical;overflow:hidden;}
  .kv{display:grid;grid-template-columns:minmax(80px,38%) 1fr;column-gap:12px;row-gap:1px;border-top:1px solid var(--ink);border-bottom:1px solid var(--ink);padding:5px 7px;margin:0;}
  .kv dd{margin:0;}
  .p-thumbs{display:flex;gap:var(--gap);}
  .p-thumbs > *{flex:1;}
  .p-thumbs .slot span{display:none;}

  .a .p-info{grid-column:1 / 7;grid-row:1;}
  .a .p-cover{grid-column:7 / 19;grid-row:1;}
  .a .p-port{grid-column:20 / 25;grid-row:1;margin-top:18%;}
  .a .p-thumbs{grid-column:7 / 13;grid-row:2;}
  .b .p-port{grid-column:1 / 6;grid-row:1;margin-top:10%;}
  .b .p-cover{grid-column:7 / 19;grid-row:1;}
  .b .p-info{grid-column:19 / 25;grid-row:1;}
  .b .p-thumbs{grid-column:13 / 19;grid-row:2;}

  .inter{display:grid;grid-template-columns:repeat(24,minmax(0,1fr));gap:var(--gap);align-items:start;margin:24px 0 96px;}
  .x-exp{grid-column:1 / 10;}
  .x-wips{grid-column:13 / 25;}
  .x-row{display:grid;grid-template-columns:1fr 1fr;gap:var(--gap);margin-top:var(--gap);align-items:end;}
  .x-cap{display:flex;justify-content:space-between;gap:12px;padding:5px 7px 0;}
  .x-line{padding:0 7px;color:var(--mute);}
  .acc{border-bottom:1px solid var(--rule);}
  .acc summary{display:flex;gap:12px;padding:5px 7px;cursor:pointer;list-style:none;}
  .acc summary::-webkit-details-marker{display:none;}
  .acc summary > :first-child{flex:1;}
  .acc summary::after{content:'+';}
  .acc[open] summary::after{content:'\2212';}
  .acc p{padding:0 7px 8px;max-width:56ch;}

  .all{scroll-margin-top:48px;}
  .tools{display:grid;grid-template-columns:repeat(4,1fr);gap:var(--gap);margin-bottom:16px;}
  .all table{width:calc(100% + 2 * var(--gap));border-collapse:separate;border-spacing:var(--gap) 0;margin:0 calc(-1 * var(--gap));table-layout:fixed;}
  .all th{text-align:left;font-weight:400;color:var(--mute);padding:4px 0;}
  .all td{padding:5px 0 3px;border-bottom:1px solid var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .all th:nth-child(1){width:6%;} .all th:nth-child(2){width:22%;} .all th:nth-child(3){width:30%;}
  .all th:nth-child(4){width:11%;} .all th:nth-child(5){width:20%;}

  .hy-bottom{position:fixed;z-index:40;left:calc(100% / 24 * 6);right:var(--gap);bottom:var(--gap);display:grid;grid-template-columns:1fr 1fr;gap:var(--gap);}

  @media (max-width:760px){
    .hy{padding-bottom:64px;}
    .hy-right .chip{display:none;}
    .flt{width:170px;}
    .hy-hero{grid-template-columns:1fr;padding:64px 0 32px;gap:16px;}
    .hy-hero h1,.hy-status{grid-column:1 / -1;}
    .hy-hero h1{font-size:30px;line-height:1.05;}

    .pm{display:flex;flex-direction:column;align-items:stretch;gap:var(--gap);margin-bottom:28px;}
    .pm .p-port,.pm .p-thumbs,.pm .kv,.pm .p-intro,.pm .go{display:none;}
    .p-info{gap:6px;}
    .p-line{font-size:15px;line-height:1.2;}

    .inter{display:flex;flex-direction:column;align-items:stretch;gap:28px;margin:8px 0 40px;}
    .x-row{grid-template-columns:1fr;}
    .x-wip .slot{display:none;}

    .tools{grid-template-columns:1fr 1fr;}
    .all table,.all tbody{display:block;width:100%;margin:0;}
    .all thead{display:none;}
    .all tr{display:grid;grid-template-columns:1fr auto;column-gap:12px;padding:6px 0 5px;border-bottom:1px solid var(--ink);}
    .all td{border:0;padding:0;white-space:normal;}
    .all td:nth-child(1),.all td:nth-child(5){display:none;}
    .all td:nth-child(2){grid-column:1;}
    .all td:nth-child(4){grid-column:2;grid-row:1;}
    .all td:nth-child(3){grid-column:1;color:var(--mute);}
    .all td:nth-child(6){grid-column:2;grid-row:2;text-align:right;}

    .hy-bottom{left:var(--gap);}
    .hy-bottom .avail{display:none;}
  }
</style>
